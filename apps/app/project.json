{
	"name": "app",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/app/src",
	"tags": [],
	"implicitDependencies": [],
	"targets": {
		"build": {
			"dependsOn": ["^build", "generate-docs-and-snippets", "generate-hlm-component-preview"],
			"executor": "@analogjs/platform:vite",
			"outputs": [
				"{options.outputPath}",
				"{workspaceRoot}/dist/apps/app/.nitro",
				"{workspaceRoot}/dist/apps/app/ssr",
				"{workspaceRoot}/dist/apps/app/analog"
			],
			"options": {
				"main": "apps/app/src/main.ts",
				"configFile": "apps/app/vite.config.ts",
				"outputPath": "dist/apps/app/client",
				"tsConfig": "apps/app/tsconfig.app.json"
			},
			"defaultConfiguration": "production",
			"configurations": {
				"development": {
					"mode": "development"
				},
				"production": {
					"sourcemap": false,
					"mode": "production"
				}
			}
		},
		"serve": {
			"dependsOn": ["generate-docs-and-snippets", "generate-hlm-component-preview"],
			"executor": "@analogjs/platform:vite-dev-server",
			"defaultConfiguration": "development",
			"options": {
				"buildTarget": "app:build",
				"port": 4200
			},
			"configurations": {
				"development": {
					"buildTarget": "app:build:development",
					"hmr": true
				},
				"production": {
					"buildTarget": "app:build:production"
				}
			}
		},
		"extract-i18n": {
			"executor": "@angular/build:extract-i18n",
			"options": {
				"browserTarget": "app:build"
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": ["{options.outputFile}"]
		},
		"test": {
			"executor": "@analogjs/platform:vitest",
			"outputs": ["{projectRoot}/coverage"]
		},
		"serve-nitro": {
			"executor": "nx:run-commands",
			"options": {
				"cwd": "",
				"command": "PORT=4205 node dist/apps/app/analog/server/index.mjs"
			},
			"dependsOn": ["build"]
		},
		"generate-ui-docs": {
			"executor": "@spartan-ng/tools:generate-ui-docs",
			"cache": true,
			"options": {
				"outputDir": "apps/app/src/public/data",
				"brainDir": "libs/brain",
				"helmDir": "libs/helm"
			},
			"inputs": [
				"{workspaceRoot}/libs/brain/**/*.ts",
				"{workspaceRoot}/libs/helm/**/*.ts",
				"!{workspaceRoot}/libs/brain/**/*.spec.ts",
				"!{workspaceRoot}/libs/helm/**/*.spec.ts",
				"{workspaceRoot}/libs/tools/src/executors/docs/generate-ui-docs/**/*",
				"{workspaceRoot}/libs/tools/src/write-per-component-data.ts",
				"{workspaceRoot}/tsconfig.base.json",
				{
					"externalDependencies": ["ts-morph"]
				}
			],
			"outputs": ["{options.outputDir}/ui-api"]
		},
		"generate-docs-and-snippets": {
			"executor": "nx:noop",
			"dependsOn": ["generate-ui-docs", "generate-primitive-snippets"]
		},
		"generate-hlm-component-preview": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"{projectRoot}/src/app/pages/**/*",
				"!{projectRoot}/src/app/pages/**/hlm-tailwind-preset.snippet.ts",
				"{workspaceRoot}/libs/cli/**/*",
				"{workspaceRoot}/libs/registry/src/styles/**/*",
				"{workspaceRoot}/libs/brain/package.json",
				"{workspaceRoot}/libs/brain/hlm-tailwind-preset.css",
				"{workspaceRoot}/libs/tools/src/generators/generate-hlm-component-preview/**/*",
				"{workspaceRoot}/libs/tools/src/write-per-component-data.ts",
				"{workspaceRoot}/package.json",
				"{workspaceRoot}/.prettierrc",
				{
					"externalDependencies": ["prettier"]
				}
			],
			"outputs": [
				"{projectRoot}/src/public/data/manual-install-snippets",
				"{projectRoot}/src/public/data/stackblitz-meta.json",
				"{projectRoot}/src/public/data/stackblitz-project.json",
				"{projectRoot}/src/app/pages/(documentation)/documentation/(ui)/hlm-tailwind-preset.snippet.ts"
			],
			"options": {
				"command": "nx generate @spartan-ng/tools:generate-hlm-component-preview"
			}
		},
		"generate-primitive-snippets": {
			"executor": "nx:run-commands",
			"cache": true,
			"inputs": [
				"{projectRoot}/src/app/pages/**/*",
				"{workspaceRoot}/libs/tools/src/generators/generate-primitive-snippets/**/*",
				"{workspaceRoot}/libs/tools/src/write-per-component-data.ts",
				"{workspaceRoot}/.prettierrc",
				{
					"externalDependencies": ["prettier", "typescript"]
				}
			],
			"outputs": [
				"{projectRoot}/src/public/data/primitives-snippets",
				"{projectRoot}/src/public/data/stackblitz-example-files.json"
			],
			"options": {
				"command": "nx generate @spartan-ng/tools:generate-primitive-snippets"
			}
		}
	}
}
